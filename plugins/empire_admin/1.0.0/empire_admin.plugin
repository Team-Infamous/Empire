FORMAT = "empire-admin-export"
FORMAT_VERSION = 1
CMD_RE = re.compile(r"^\.([a-z]+)(?:@\w+)?(?:\s+(.*))?$", re.IGNORECASE | re.DOTALL)
NOTE_RE = re.compile(r"^#([\w-]{1,32})$")
NOTE_NAME_RE = re.compile(r"^[\w-]{1,32}$")
DUR_RE = re.compile(r"(\d+)([smhdw])")
UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800}
MIN_RESTRICT, MAX_RESTRICT = 30, 366 * 86400
WARN_MODES = ("ban", "kick", "mute", "tban", "tmute")
MAX_PURGE = 1000
SEND_FLAGS = ["send_messages", "send_media", "send_stickers", "send_gifs", "send_games", "send_inline",
              "embed_links", "send_polls", "send_photos", "send_videos", "send_roundvideos",
              "send_audios", "send_voices", "send_docs", "send_plain"]
BAN_EXTRA = ["change_info", "invite_users", "pin_messages", "manage_topics"]
ADMIN_TTL = 600
FILTER_COOLDOWN = 8
MAX_IMPORT_BYTES = 2 * 1024 * 1024
LIMITS = {"rules": 4000, "note": 4000, "notes": 200, "filters": 100, "trigger": 64, "reason": 200,
          "warn_users": 1000, "warn_each": 20}

ALIASES = {"warns": "warnings", "stopfilter": "stop", "unpinall": "unpin", "d": "del", "help": "adminhelp"}
